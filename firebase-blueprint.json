{
  "entities": {
    "Purchase": {
      "title": "Purchase",
      "description": "CAMS GOLD purchase record including karat, gross and non-gold weight, payments and supplier",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "reference": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 500 },
        "amount": { "type": "number" },
        "purchasedAt": { "type": "string", "maxLength": 64 },
        "supplier": { "type": "string", "maxLength": 128 },
        "grossWeightGrams": { "type": "number" },
        "nonGoldWeightGrams": { "type": "number" },
        "netWeightGrams": { "type": "number" },
        "karat": { "type": "string", "maxLength": 10 },
        "goldCategory": { "type": "string", "maxLength": 64 },
        "purityPercent": { "type": "number" },
        "referencePricePerGram": { "type": "number" },
        "cancelledAt": { "type": "string", "maxLength": 64 },
        "cancellationReason": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "amount", "purchasedAt"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Gold sale record with automatic stock deduction and direct cash desk deposit",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 500 },
        "profit": { "type": "number" },
        "revenue": { "type": "number" },
        "weightGrams": { "type": "number" },
        "karat": { "type": "string", "maxLength": 10 },
        "category": { "type": "string", "maxLength": 64 },
        "targetAccount": { "type": "string", "maxLength": 128 },
        "soldAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "description", "revenue", "weightGrams", "karat"]
    },
    "StockMovement": {
      "title": "StockMovement",
      "description": "Gold stock ledger movement (purchase addition, sale subtraction, or physical correction)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "label": { "type": "string", "maxLength": 256 },
        "karat": { "type": "string", "maxLength": 10 },
        "weightGrams": { "type": "number" },
        "date": { "type": "string", "maxLength": 64 },
        "type": { "type": "string", "maxLength": 32 },
        "category": { "type": "string", "maxLength": 64 },
        "reason": { "type": "string", "maxLength": 500 },
        "referenceId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "karat", "weightGrams", "type"]
    },
    "Contact": {
      "title": "Contact",
      "description": "Client, supplier, or foreign trading partner",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "reference": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 64 },
        "city": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "maxLength": 128 },
        "appointment": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 1000 },
        "contactType": { "type": "string", "maxLength": 32 },
        "preferredCurrency": { "type": "string", "maxLength": 16 },
        "language": { "type": "string", "maxLength": 16 },
        "whatsappStatus": { "type": "string", "maxLength": 32 },
        "consentGranted": { "type": "boolean" },
        "consentDate": { "type": "string", "maxLength": 64 },
        "consentProof": { "type": "string", "maxLength": 256 },
        "broadcastEnabled": { "type": "boolean" },
        "unsubscribed": { "type": "boolean" },
        "unsubscribedAt": { "type": "string", "maxLength": 64 },
        "archived": { "type": "boolean" }
      },
      "required": ["reference", "name"]
    },
    "LedgerEntry": {
      "title": "LedgerEntry",
      "description": "CAMS GOLD treasury and general ledger financial movement",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "subtitle": { "type": "string", "maxLength": 256 },
        "amount": { "type": "number" },
        "date": { "type": "string", "maxLength": 64 },
        "isIncome": { "type": "boolean" },
        "isProcessed": { "type": "boolean" },
        "isTransfer": { "type": "boolean" },
        "isDeposit": { "type": "boolean" }
      },
      "required": ["id", "title", "amount"]
    },
    "BankBalance": {
      "title": "BankBalance",
      "description": "Cash register or bank account balance in FCFA",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 128 },
        "balance": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["name", "balance"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Global settings and purchase formula configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "purchaseFormulaConfig": { "type": "string", "maxLength": 4096 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id"]
    },
    "User": {
      "title": "User",
      "description": "CAMS GOLD staff user with assigned role, profile and status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 64 },
        "role": { "type": "string", "maxLength": 32 },
        "roleLabel": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "role", "status"]
    },
    "Task": {
      "title": "Task",
      "description": "CAMS GOLD operational task assigned by administrator to a role or specific user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "reference": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 256 },
        "description": { "type": "string", "maxLength": 1000 },
        "assignedRole": { "type": "string", "maxLength": 32 },
        "assignedUserId": { "type": "string", "maxLength": 128 },
        "assignedUserName": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "maxLength": 64 },
        "priority": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "maxLength": 32 },
        "dueDate": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "completionNote": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "reference", "title", "assignedRole", "status"]
    },
    "WhatsAppCampaign": {
      "title": "WhatsAppCampaign",
      "description": "Scheduled 09h00 or exceptional WhatsApp broadcast campaign",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "reference": { "type": "string", "maxLength": 64 },
        "type": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "maxLength": 32 },
        "triggeredAt": { "type": "string", "maxLength": 64 },
        "scheduledDate": { "type": "string", "maxLength": 32 },
        "timezone": { "type": "string", "maxLength": 64 },
        "totalTargeted": { "type": "number" },
        "eligibleCount": { "type": "number" },
        "blockedCount": { "type": "number" },
        "sentCount": { "type": "number" },
        "deliveredCount": { "type": "number" },
        "readCount": { "type": "number" },
        "failedCount": { "type": "number" },
        "createdBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "reference", "type", "status", "triggeredAt"]
    },
    "WhatsAppMessageLog": {
      "title": "WhatsAppMessageLog",
      "description": "Individual WhatsApp dispatch record with status, idempotency key and delivery proof",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "campaignId": { "type": "string", "maxLength": 128 },
        "campaignRef": { "type": "string", "maxLength": 64 },
        "idempotencyKey": { "type": "string", "maxLength": 192 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "contactRef": { "type": "string", "maxLength": 64 },
        "contactName": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 64 },
        "category": { "type": "string", "maxLength": 64 },
        "messageType": { "type": "string", "maxLength": 32 },
        "currencyCode": { "type": "string", "maxLength": 16 },
        "priceSummary": { "type": "string", "maxLength": 256 },
        "renderedText": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "maxLength": 32 },
        "whatsappMessageId": { "type": "string", "maxLength": 128 },
        "errorReason": { "type": "string", "maxLength": 500 },
        "retryCount": { "type": "number" }
      },
      "required": ["id", "campaignId", "idempotencyKey", "contactName", "phone", "status"]
    },
    "WhatsAppAuditLog": {
      "title": "WhatsAppAuditLog",
      "description": "Audit log of WhatsApp automation changes (rates, stocks, contacts, campaigns)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "actorName": { "type": "string", "maxLength": 128 },
        "actorRole": { "type": "string", "maxLength": 32 },
        "action": { "type": "string", "maxLength": 128 },
        "entityType": { "type": "string", "maxLength": 32 },
        "summary": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "timestamp", "actorName", "action", "entityType", "summary"]
    }
  },
  "firestore": {
    "/purchases/{purchaseId}": {
      "schema": "Purchase",
      "description": "CAMS GOLD purchases"
    },
    "/sales/{saleId}": {
      "schema": "Sale",
      "description": "Gold sales and export transactions"
    },
    "/stock_movements/{movementId}": {
      "schema": "StockMovement",
      "description": "Gold stock ledger entries"
    },
    "/contacts/{contactId}": {
      "schema": "Contact",
      "description": "Clients and suppliers"
    },
    "/operations/{operationId}": {
      "schema": "LedgerEntry",
      "description": "Treasury journal operations"
    },
    "/accounts/{accountId}": {
      "schema": "BankBalance",
      "description": "Bank accounts and cash desk balances"
    },
    "/settings/{settingsId}": {
      "schema": "Settings",
      "description": "Formula configuration and application preferences"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Staff users and roles"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Operational tasks assigned to roles"
    },
    "/whatsapp_campaigns/{campaignId}": {
      "schema": "WhatsAppCampaign",
      "description": "Scheduled and exceptional WhatsApp campaigns"
    },
    "/whatsapp_logs/{logId}": {
      "schema": "WhatsAppMessageLog",
      "description": "WhatsApp message dispatch queue and delivery logs"
    },
    "/whatsapp_audit_logs/{auditId}": {
      "schema": "WhatsAppAuditLog",
      "description": "Immutable audit trail for WhatsApp automation"
    }
  }
}
